# Copy to .env for local development. In production set these in your hosting dashboard.
# Never commit real values.

NODE_ENV=production
PORT=8080

# Database (PostgreSQL). DIRECT_URL is only needed for prisma db push / migrate.
DATABASE_URL=
DIRECT_URL=

# Better Auth
BETTER_AUTH_SECRET=            # long random string, for example: openssl rand -base64 32
APP_BASE_URL=                  # with the Vercel proxy: the frontend URL plus /backend, e.g. https://your-app.vercel.app/backend
FRONTEND_URL=                  # public URL of the frontend, e.g. https://your-app.vercel.app

# Arcjet
ARCJET_KEY=
ARCJET_ENV=production
ARCJET_MODE=LIVE

# Resend (email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=             # an address on a verified domain; onboarding@resend.dev only reaches your own inbox
CONTACT_TO_EMAIL=              # inbox that receives contact form messages
MAIL_OVERRIDE_TO=              # optional: send every email to this inbox (development only)

# Hosting
TRUST_PROXY=1                  # set when running behind a proxy such as Railway, Render or Fly

# Caching (optional). Without these two the cache lives in each server's memory.
# Use the REST values from the Upstash database page (the REST API section), not the rediss:// address.
UPSTASH_REDIS_REST_URL=        # https://<name>.upstash.io (KV_REST_API_URL from Vercel's integration also works)
UPSTASH_REDIS_REST_TOKEN=      # the REST token (KV_REST_API_TOKEN also works)
CACHE_PREFIX=hackathon:

# Scheduled jobs. POST /cron/:job needs "Authorization: Bearer <CRON_SECRET>".
# Generate a long random value, and put the same one in the GitHub secret CRON_SECRET.
CRON_SECRET=
DISABLE_CRON=                  # set to 1 to switch off the in-process schedules on a normal server
